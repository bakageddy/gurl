# Maintainer: bakageddy
# Build a pacman package of Zurl from a tagged source tarball:
#   cd packaging/arch && makepkg -si
pkgname=zurl
pkgver=0.1.0
pkgrel=1
pkgdesc='A native-feeling GUI for HURL: workspaces, a visual request builder and reports'
arch=('x86_64')
url='https://github.com/bakageddy/zurl'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator-gtk3' 'librsvg' 'openssl')
makedepends=('rust' 'nodejs' 'npm' 'git' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver/zurl"
  npm ci
  npm run tauri build -- --no-bundle
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 zurl/src-tauri/target/release/zurl "$pkgdir/usr/bin/zurl"
  install -Dm644 packaging/zurl.desktop "$pkgdir/usr/share/applications/zurl.desktop"
  install -Dm644 zurl/src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/zurl.png"
}

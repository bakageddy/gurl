# Maintainer: bakageddy
# Build a pacman package of gURL from a tagged source tarball:
#   cd packaging/arch && makepkg -si
pkgname=gurl
pkgver=0.4.0
pkgrel=1
pkgdesc='A native-feeling GUI for HURL: workspaces, a visual request builder and reports'
arch=('x86_64')
url='https://github.com/bakageddy/gurl'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator-gtk3' 'librsvg' 'openssl')
makedepends=('rust' 'nodejs' 'npm' 'git' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  # Release tarballs don't include submodules: fetch HURL at the pinned tag (gurl/vendor/hurl).
  cd "$pkgname-$pkgver"
  rm -rf gurl/vendor/hurl
  git clone --depth 1 --branch 8.0.1 https://github.com/Orange-OpenSource/hurl gurl/vendor/hurl
}

build() {
  cd "$pkgname-$pkgver/gurl"
  npm ci
  npm run tauri build -- --no-bundle
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 gurl/src-tauri/target/release/gurl "$pkgdir/usr/bin/gurl"
  install -Dm644 packaging/gurl.desktop "$pkgdir/usr/share/applications/gurl.desktop"
  install -Dm644 gurl/src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/gurl.png"
}
